# of this software and associated documentation files (the "Software"), to deal
# in the Software without restriction, including without limitation the rights
# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
#
# The above copyright notice and this permission notice shall be included in all
# copies or substantial portions of the Software.
#
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
#

_tool="${0##*/}"

# show verbose output
VERBOSE="${VERBOSE:-false}"

# host X display to render the sandbox display into
FSUNABA_HOST_DISPLAY="${FSUNABA_HOST_DISPLAY:-${DISPLAY:-}}"

# sandbox user
FSUNABA_USER="${FSUNABA_USER:-fsunaba}"

# amnesic sandbox user, whose home directory is erased around each session
FSUNABA_AMNESIC_USER="${FSUNABA_AMNESIC_USER:-${FSUNABA_USER}-amnesic}"

# sandbox display size in pixels: remember whether the caller chose a size, so
# that application-specific defaults apply only when nothing was requested
_SIZE_SET=no
[[ -n "${WIDTH:-}" || -n "${HEIGHT:-}" ]] && _SIZE_SET=yes
WIDTH="${WIDTH:-1024}"
HEIGHT="${HEIGHT:-768}"

# seconds to wait for Xephyr to become ready
FSUNABA_TIMEOUT="${FSUNABA_TIMEOUT:-10}"

# additional options passed to Xephyr
FSUNABA_XEPHYR_OPTS="${FSUNABA_XEPHYR_OPTS:-}"

# window manager to run inside the sandbox when the -w option is used
FSUNABA_WM="${FSUNABA_WM:-cwm}"

# private runtime state
_XEPHYR_PID=""
_XEPHYR_LOG=""
_TMPDIR=""
_XAUTH=""
_SANDBOX_XAUTH_DIR=""
_SANDBOX_XAUTH=""
_DISPLAY=""
_DISPLAY_NUM=""
_SANDBOX_HOME=""
_INVOKING_HOME=""
_HOST_AUTH=no
_SANDBOX_AUTH=no
_AMNESIC=no
_AMNESIC_WIPE=no
_WM=""
_XDOOL=""
_FIT=0
_FOLLOW=no

# print an error to stderr and exit
_fatal() {
  print -u2 -r -- "${_tool}: $1! Exiting."
  exit "${2:-1}"
}

# print basic help
_usage() {
  cat <<EOF
Usage: ${_tool} [-hvrGAw] [-d display] [-s widthxheight] [-u user] command [argument ...]

Run command in a sandboxed X display as a separate user.

Options:
  -A           run as the amnesic user and erase its home directory
  -d display   host X display to render the sandbox into (default: \$DISPLAY)
  -G           do not let the sandbox grab the keyboard and mouse
  -h           show this help and exit
  -r           make the sandbox window resizeable
  -s WxH       sandbox display size in pixels (default: 1024x768)
  -u user      sandbox user to run command as (default: fsunaba)
  -v           show verbose output
  -w           run a window manager in the sandbox (default: cwm)
EOF
}

# fail unless a value is a positive integer
_require_positive_int() {
  case "$2" in '' | *[!0-9]*) _fatal "invalid $1 '$2'" 2 ;; esac
  [[ "$2" -gt 0 ]] || _fatal "invalid $1 '$2'" 2
}

# print the physical path of a directory, so two spellings of the same
# directory compare equal; the path itself when it cannot be resolved
_real_path() {
  realpath "$1" 2>/dev/null || print "$1"
}

# refuse to erase anything that is not a dedicated, non-privileged home: the
# path must be a real directory owned by the sandbox user and must not resolve
# to the invoking user's own home, or the wipe would follow a link or a replaced
# path and erase something else. The link is tested before the location, so a
# linked home is refused wherever it points.
_amnesic_guard() {
  [[ "$FSUNABA_USER" != "$(id -un)" ]] \
    || _fatal "refusing to erase the invoking user's home directory"
  [[ "$(id -u "$FSUNABA_USER")" != "$(id -u)" ]] \
    || _fatal "refusing to erase the invoking user's home directory"
  [[ "$FSUNABA_USER" != root ]] \
    || _fatal "refusing to erase root's home directory"
  [[ ! -L "$_SANDBOX_HOME" ]] \
    || _fatal "amnesic home '${_SANDBOX_HOME}' is a symbolic link"
  case "$_SANDBOX_HOME" in
    /home/*) ;;
    *) _fatal "amnesic home '${_SANDBOX_HOME}' is not under /home" ;;
  esac
  [[ "$(_real_path "$_SANDBOX_HOME")" != "$(_real_path "$_INVOKING_HOME")" ]] \
    || _fatal "amnesic home '${_SANDBOX_HOME}' is the invoking user's home directory"
  [[ "$(stat -f %Su "$_SANDBOX_HOME")" == "$FSUNABA_USER" ]] \
    || _fatal "amnesic home '${_SANDBOX_HOME}' is not owned by '${FSUNABA_USER}'"
  return 0
}

# print Xephyr's diagnostics, which are shown only when it fails to start
_show_xephyr_log() {
  [[ -s "$_XEPHYR_LOG" ]] || return 0
  print -u2 -r -- "${_tool}: Xephyr reported:"
  cat "$_XEPHYR_LOG" >&2
}

# print the numeric part of an X display name, when it has one
_host_display_number() {
  local display="${1##*:}"
  display="${display%%.*}"
  case "$display" in
    '' | *[!0-9]*) return 0 ;;
  esac
  print "$display"
}

# print the lowest display number that is free on this host, skipping the host
# display itself and every display that already has a lock file or a socket
_free_display() {
  local host="${1:-}"
  local number=0
  while (( number < 1000 )); do
    if [[ ":${number}" != ":${host}" ]] \
      && [[ ! -e "/tmp/.X${number}-lock" ]] \
      && [[ ! -e "/tmp/.X11-unix/X${number}" ]]; then
      print "$number"
      return 0
    fi
    (( number++ ))
  done
  return 1
}

# print the host display's usable size in pixels as "width height", taken from
# the window manager's work area when it publishes one and from the display
# otherwise; used to keep the default sandbox size inside the screen
_host_area() {
  local area=""
  area="$(DISPLAY="$FSUNABA_HOST_DISPLAY" xprop -root -notype _NET_WORKAREA \
    2>/dev/null | sed -n 's/.*= *//p' | cut -d, -f3,4 | tr -d ' ' | tr ',' ' ')"
  case "$area" in
    [0-9]*' '[0-9]*) print "$area"; return 0 ;;
  esac
  area="$(DISPLAY="$FSUNABA_HOST_DISPLAY" xdpyinfo 2>/dev/null \
    | sed -n 's/.*dimensions: *\([0-9]*\)x\([0-9]*\).*/\1 \2/p')"
  case "$area" in
    [0-9]*' '[0-9]*) print "$area" ;;
  esac
}

# erase every entry inside the sandbox home directory, then report leftovers
#
# Runs in the home directory first, because a process that cannot read its
# working directory makes find fall back to full paths, which is both slow and
# refused by some of its primaries. Uses rm through find rather than
# find -delete, which aborts the whole walk on OpenBSD when it sees such paths.
_wipe_home() {
  local flag="${1:-}"
  local output=""
  # a wipe needs an accepted guard, which is what sets _AMNESIC_WIPE, and a home
  # that is not the invoking user's own, whatever the caller did
  [[ "$_AMNESIC_WIPE" == yes ]] || {
    print -u2 -r -- "${_tool}: refusing to wipe an unauthorized home"
    return 1
  }
  [[ -n "$_SANDBOX_HOME" && -d "$_SANDBOX_HOME" ]] || return 0
  [[ "$(_real_path "$_SANDBOX_HOME")" != "$(_real_path "$_INVOKING_HOME")" ]] || {
    print -u2 -r -- "${_tool}: refusing to erase the invoking user's home directory"
    return 1
  }
  output="$(doas $flag -u "$FSUNABA_USER" /bin/sh -c '
      cd "$1" || exit 1
      chmod -R u+rwX "$1" 2>/dev/null
      find "$1" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>&1
      ls -A "$1" 2>/dev/null | head -1
    ' _ "$_SANDBOX_HOME" 2>&1)" || {
    print -u2 -r -- "${_tool}: could not erase '${_SANDBOX_HOME}'"
    [[ -n "$output" ]] && print -u2 -r -- "$output"
    return 1
  }
  if [[ -n "$output" ]]; then
    print -u2 -r -- "${_tool}: '${_SANDBOX_HOME}' is not empty after erasing:"
    print -u2 -r -- "$output"
    return 1
  fi
  return 0
}

# stop Xephyr, remove authentication cookies, and delete private state
_cleanup() {
  if [[ -n "$_XEPHYR_PID" ]]; then
    kill "$_XEPHYR_PID" 2>/dev/null
    wait "$_XEPHYR_PID" 2>/dev/null
    _XEPHYR_PID=""
  fi
  if [[ "$_HOST_AUTH" == yes ]]; then
    xauth -f "$_XAUTH" remove "$_DISPLAY" 2>/dev/null
    _HOST_AUTH=no
  fi
  if [[ "$_SANDBOX_AUTH" == yes ]]; then
    doas -n -u "$FSUNABA_USER" env HOME="$_SANDBOX_HOME" \
      XAUTHORITY="$_SANDBOX_XAUTH" xauth remove "$_DISPLAY" 2>/dev/null
    _SANDBOX_AUTH=no
  fi
  # the session authority file is only as valuable as the cookie it holds, but
  # it lives in the sandbox user's home, so remove it rather than leave a file
  # that outlives the session
  if [[ -n "$_SANDBOX_XAUTH" ]]; then
    doas -n -u "$FSUNABA_USER" /bin/rm -f "$_SANDBOX_XAUTH" 2>/dev/null
    _SANDBOX_XAUTH=""
  fi
  # only wipe a home the guard accepted: when the guard refuses, the session
  # never started, and erasing the very home it refused would defeat the guard
  if [[ "$_AMNESIC_WIPE" == yes ]]; then
    _wipe_home -n
    _AMNESIC_WIPE=no
  fi
  if [[ -n "$_TMPDIR" ]]; then
    rm -rf "$_TMPDIR"
    _TMPDIR=""
  fi
}

# parse options
while getopts :Ad:Ghrs:u:vw _opt; do
  case "$_opt" in
    A) _AMNESIC=yes ;;
    d) FSUNABA_HOST_DISPLAY="$OPTARG" ;;
    G) FSUNABA_XEPHYR_OPTS="${FSUNABA_XEPHYR_OPTS} -no-host-grab" ;;
    h) _usage; exit 0 ;;
    r) FSUNABA_XEPHYR_OPTS="${FSUNABA_XEPHYR_OPTS} -resizeable" ;;
    s)
      WIDTH="${OPTARG%%x*}"
      HEIGHT="${OPTARG##*x}"
      _SIZE_SET=yes
      ;;
    u) FSUNABA_USER="$OPTARG" ;;
    v) VERBOSE=true ;;
    w) _WM="$FSUNABA_WM" ;;
    :) _fatal "the '-${OPTARG}' option requires an argument" 2 ;;
    ?) _fatal "unknown option '-${OPTARG}'" 2 ;;
  esac
done
shift $((OPTIND - 1))

# amnesic mode always runs as the amnesic sandbox user
if [[ "$_AMNESIC" == yes ]]; then
  FSUNABA_USER="$FSUNABA_AMNESIC_USER"
fi

# validate input
[[ -n "$FSUNABA_HOST_DISPLAY" ]] \
  || _fatal "no host X display; set DISPLAY or use the '-d' option"
[[ $# -gt 0 ]] || { _usage >&2; _fatal "no command specified" 2; }
case "$FSUNABA_USER" in
  '' | -* | *[!A-Za-z0-9._-]*)
    _fatal "invalid sandbox username '${FSUNABA_USER}'" 2
    ;;
esac
if ! id -u "$FSUNABA_USER" >/dev/null 2>&1; then
  if [[ "$_AMNESIC" == yes ]]; then
    _fatal "amnesic user '${FSUNABA_USER}' does not exist; run 'make install-amnesic-user'"
  fi
  _fatal "sandbox user '${FSUNABA_USER}' does not exist"
fi
# a privileged sandbox user could escalate from inside the sandbox, so refuse
# it, and never run the outer session as root
[[ "$(id -u)" -ne 0 ]] \
  || _fatal "refusing to run as root, the sandbox must stay unprivileged"
if id -Gn "$FSUNABA_USER" | grep -qwE 'wheel|operator'; then
  _fatal "sandbox user '${FSUNABA_USER}' must not be in wheel or operator"
fi
_require_positive_int width "$WIDTH"
_require_positive_int height "$HEIGHT"
_require_positive_int timeout "$FSUNABA_TIMEOUT"
if [[ -n "$_WM" ]]; then
  command -v "${_WM%% *}" >/dev/null \
    || _fatal "window manager '${_WM%% *}' not found"
fi

# refuse Xephyr options that would weaken the sandbox: -ac and -auth hand
# access control away, -nolock removes the display lock that keeps two sessions
# apart, -listen exposes the display on the network, and +iglx enables the
# indirect GLX path
for _opt in ${FSUNABA_XEPHYR_OPTS}; do
  case "$_opt" in
    -ac | -auth | -nolock | -listen | +iglx)
      _fatal "refusing Xephyr option '${_opt}' in FSUNABA_XEPHYR_OPTS" 2
      ;;
  esac
done

# keep application windows matched to the sandbox display when the optional
# xdotool is available: Firefox sizes its window from the screen, so a browser
# can start short of the display or larger than it, and -r needs windows resized
# when the display changes. The path is fixed, not taken from PATH, because it
# is executed in the sandbox.
case "${1##*/}" in
  chrome | chromium | ungoogled-chromium | firefox | tor-browser) _FIT=20 ;;
esac
case " ${FSUNABA_XEPHYR_OPTS} " in
  *" -resizeable "*) _FOLLOW=yes ;;
esac
if [[ "$_FIT" -gt 0 || "$_FOLLOW" == yes ]]; then
  for _xd in /usr/local/bin/xdotool /usr/bin/xdotool /usr/X11R6/bin/xdotool; do
    if [[ -x "$_xd" ]]; then
      _XDOOL="$_xd"
      break
    fi
  done
  if [[ -z "$_XDOOL" && "$VERBOSE" == true ]]; then
    print "${_tool}: xdotool not found; window sizing will not be adjusted."
  fi
fi

# create private runtime state and clean it up on any exit or signal
umask 077
_TMPDIR="$(mktemp -d "${TMPDIR:-/tmp}/fsunaba.XXXXXXXX")" \
  || _fatal "could not create a temporary directory"
_XAUTH="${_TMPDIR}/Xauthority"
_XEPHYR_LOG="${_TMPDIR}/xephyr.log"
: > "$_XAUTH"
trap '_cleanup' EXIT
trap '_cleanup; exit 129' HUP
trap '_cleanup; exit 130' INT
trap '_cleanup; exit 143' TERM

# resolve the sandbox user's home directory
_SANDBOX_HOME="$(getent passwd "$FSUNABA_USER" | cut -d: -f6)"
[[ -n "$_SANDBOX_HOME" ]] \
  || _fatal "could not determine the home directory of '${FSUNABA_USER}'"
[[ -d "$_SANDBOX_HOME" ]] \
  || _fatal "sandbox home '${_SANDBOX_HOME}' does not exist"

# erase any leftovers from a previous amnesic session
if [[ "$_AMNESIC" == yes ]]; then
  # resolve the invoking user's own home directory, which a wipe must never
  # touch; refuse when it cannot be determined
  _INVOKING_HOME="$(getent passwd "$(id -un)" | cut -d: -f6)"
  [[ -n "$_INVOKING_HOME" ]] || _INVOKING_HOME="${HOME:-}"
  [[ -n "$_INVOKING_HOME" ]] \
    || _fatal "could not determine the invoking user's home directory"
  _amnesic_guard
  _AMNESIC_WIPE=yes
  [[ "$VERBOSE" == true ]] && print "Wiping amnesic home '${_SANDBOX_HOME}'..."
  _wipe_home || _fatal "could not erase the amnesic home directory"
fi

# let applications with strict default window sizes choose a sandbox display,
# then keep the default inside the host screen so the sandbox window fits; an
# explicit size with -s or WIDTH/HEIGHT is always used as given
case "${1##*/}" in
  tor-browser)
    # Tor Browser's anti-fingerprinting rounds its content to multiples of
    # 200x100 and sizes the window from the screen, so the display size decides
    # how much room it takes; 1000x1000 is the size it expects
    if [[ "$_SIZE_SET" == no ]]; then
      WIDTH=1000
      HEIGHT=1000
    fi
    ;;
esac
if [[ "$_SIZE_SET" == no ]]; then
  _area="$(_host_area)"
  _aw="${_area%% *}"
  _ah="${_area##* }"
  case "$_aw" in
    '' | *[!0-9]*) ;;
    *) [[ "$_aw" -lt "$WIDTH" ]] && WIDTH="$_aw" ;;
  esac
  case "$_ah" in
    '' | *[!0-9]*) ;;
    *) [[ "$_ah" -lt "$HEIGHT" ]] && HEIGHT="$_ah" ;;
  esac
fi

# append window geometry options for known applications
case "${1##*/}" in
  chrome | chromium | ungoogled-chromium)
    set -- "$@" -window-size="${WIDTH},${HEIGHT}" --window-position=0,0
    ;;
  firefox)
    set -- "$@" -width "$WIDTH" -height "$HEIGHT"
    ;;
  tor-browser)
    set -- "$@" -width "$WIDTH" -height "$HEIGHT"
    ;;
esac

# generate an authentication cookie
_MCOOKIE="$(openssl rand -hex 16)" \
  || _fatal "could not generate an authentication cookie"

# choose a free display and start Xephyr on it, retrying if a second invocation
# takes the same number first. Xephyr's -displayfd is deliberately not used: it
# disables the server lock and then takes over a socket already owned by the same
# user, so a second session would end up sharing the first one's display.
[[ "$VERBOSE" == true ]] \
  && print "Starting Xephyr on host display '${FSUNABA_HOST_DISPLAY}'..."
_tries=0
while :; do
  _DISPLAY_NUM="$(_free_display "$(_host_display_number "$FSUNABA_HOST_DISPLAY")")" \
    || _fatal "could not find a free display number"
  _DISPLAY=":${_DISPLAY_NUM}"
  printf 'add %s . %s\n' "$_DISPLAY" "$_MCOOKIE" \
    | xauth -f "$_XAUTH" source - \
    || _fatal "could not store the host authentication cookie"
  _HOST_AUTH=yes
  DISPLAY="$FSUNABA_HOST_DISPLAY" Xephyr "$_DISPLAY" ${FSUNABA_XEPHYR_OPTS} \
    -auth "$_XAUTH" -screen "${WIDTH}x${HEIGHT}" -br \
    -nolisten tcp >"$_XEPHYR_LOG" 2>&1 &
  _XEPHYR_PID=$!

  # wait for Xephyr to create the display socket, with a timeout
  _waited=0
  while [[ ! -e "/tmp/.X11-unix/X${_DISPLAY_NUM}" ]]; do
    if ! kill -0 "$_XEPHYR_PID" 2>/dev/null; then
      break
    fi
    if (( _waited >= FSUNABA_TIMEOUT )); then
      _show_xephyr_log
      _fatal "timed out waiting for Xephyr to start"
    fi
    sleep 1
    (( _waited++ ))
  done
  if kill -0 "$_XEPHYR_PID" 2>/dev/null \
    && [[ -e "/tmp/.X11-unix/X${_DISPLAY_NUM}" ]]; then
    break
  fi

  # the display was taken in the meantime; drop it and try another number
  kill "$_XEPHYR_PID" 2>/dev/null
  wait "$_XEPHYR_PID" 2>/dev/null
  _XEPHYR_PID=""
  xauth -f "$_XAUTH" remove "$_DISPLAY" 2>/dev/null
  _HOST_AUTH=no
  (( _tries++ ))
  if (( _tries >= 5 )); then
    _show_xephyr_log
    _fatal "could not start Xephyr on a free display"
  fi
done

# store the authentication cookie for the sandbox user in an authority file of
# this session, inside its home but never the shared ~/.Xauthority: that file
# outlives the session, so every session of the same sandbox user could read the
# cookie of a session it does not own. The file is created private and truncated
# first, so a stale file from a killed session cannot carry a live cookie. The
# cookie is still fed through a pipe, because process arguments are readable by
# every local user.
[[ "$VERBOSE" == true ]] && print "Sandbox display is '${_DISPLAY}'."
_SANDBOX_XAUTH_DIR="${_SANDBOX_HOME}/.fsunaba"
_SANDBOX_XAUTH="${_SANDBOX_XAUTH_DIR}/Xauthority.${_DISPLAY_NUM}"
_xa_out="$(doas -u "$FSUNABA_USER" /bin/sh -c '
    umask 077
    mkdir -p "$1" && chmod 700 "$1" || exit 1
    : > "$2" && chmod 600 "$2" || exit 1
  ' _ "$_SANDBOX_XAUTH_DIR" "$_SANDBOX_XAUTH" 2>&1)" \
  || _fatal "could not create the session authority file: ${_xa_out}"
_xa_out="$(printf 'add %s . %s\n' "$_DISPLAY" "$_MCOOKIE" \
  | doas -u "$FSUNABA_USER" env HOME="$_SANDBOX_HOME" \
    XAUTHORITY="$_SANDBOX_XAUTH" xauth source - 2>&1)" \
  || _fatal "could not store the sandbox authentication cookie: ${_xa_out}"
_SANDBOX_AUTH=yes

# run the window manager, if requested, and the application, both in the
# application's home directory and with a minimal environment, then propagate
# the application's exit status. The application arguments are passed through
# unchanged; the window manager command is the only one that is word-split. The
# root cursor is set here as well, because without a window manager nothing does
# it and popup windows without a cursor of their own would inherit the server
# default, a large X. When the sandbox display is resizeable and xdotool is
# installed, a small helper keeps application windows matched to the new size.
[[ "$VERBOSE" == true && -n "$_WM" ]] \
  && print "Starting window manager '${_WM}' in the sandbox..."
[[ "$VERBOSE" == true ]] \
  && print "Launching '${1##*/}' as '${FSUNABA_USER}' on '${_DISPLAY}'..."
doas -u "$FSUNABA_USER" /bin/sh -c '
  home="$1"; display="$2"; wm="$3"; xtool="$4"; settle="$5"; follow="$6"; xauth="$7"
  shift 7
  PATH="/usr/bin:/bin:/usr/X11R6/bin:/usr/local/bin"
  export PATH
  # use the authority file of this session, not the shared ~/.Xauthority
  XAUTHORITY="$xauth"
  export XAUTHORITY
  # everything the application creates stays private to the sandbox user
  umask 077
  cd "$home" || exit 1
  # keep the largest visible window matched to the sandbox display: a browser
  # sizes its window from the screen, so it can start short of the display or
  # larger than it, and -r needs the window resized when the display changes.
  # Run for settle seconds after the window appears, and after each change.
  _follow_resize() {
    _robot="$1"; _dpy="$2"; _settle="$3"; _follow="$4"; _old=""; _fails=0; _age=0
    while :; do
      _new="$(DISPLAY="$_dpy" xwininfo -root 2>/dev/null \
        | grep -E "Width:|Height:" | tr -cd "0-9\n" | tr "\n" " ")"
      if [ -z "$_new" ]; then
        # the display can be briefly busy while Xephyr resizes it; only give up
        # after several failures in a row, so the follower survives a resize
        _fails=$(( _fails + 1 ))
        [ "$_fails" -lt 5 ] || exit 0
        sleep 1
        continue
      fi
      _fails=0
      set -- $_new
      [ "$#" -eq 2 ] || { _old=""; sleep 1; continue; }
      case "$1$2" in
        *[!0-9]*) _old=""; sleep 1; continue ;;
      esac
      _dw="$1"; _dh="$2"
      _best=""; _bestarea=0; _bw=0; _bh=0; _bx=0; _by=0
      for _win in $(DISPLAY="$_dpy" "$_robot" search --onlyvisible . 2>/dev/null); do
        _geom="$(DISPLAY="$_dpy" "$_robot" getwindowgeometry --shell "$_win" 2>/dev/null)"
        _gw="$(printf "%s\n" "$_geom" | sed -n "s/^WIDTH=//p")"
        _gh="$(printf "%s\n" "$_geom" | sed -n "s/^HEIGHT=//p")"
        _gx="$(printf "%s\n" "$_geom" | sed -n "s/^X=//p")"
        _gy="$(printf "%s\n" "$_geom" | sed -n "s/^Y=//p")"
        [ -n "$_gw" ] || continue
        [ -n "$_gh" ] || continue
        case "$_gw" in *[!0-9]*) continue ;; esac
        case "$_gh" in *[!0-9]*) continue ;; esac
        [ -n "$_gx" ] || _gx=0
        [ -n "$_gy" ] || _gy=0
        case "$_gx" in *[!0-9-]*) _gx=0 ;; esac
        case "$_gy" in *[!0-9-]*) _gy=0 ;; esac
        _area=$(( _gw * _gh ))
        if [ "$_area" -gt "$_bestarea" ]; then
          _bestarea="$_area"
          _best="$_win"
          _bw="$_gw"
          _bh="$_gh"
          _bx="$_gx"
          _by="$_gy"
        fi
      done
      _fit=no
      if [ -n "$_old" ] && [ "$_old" != "$_new" ]; then
        _fit=yes
      elif [ -n "$_best" ] && [ "$_settle" -gt 0 ]; then
        _fit=yes
        _settle=$(( _settle - 1 ))
      fi
      if [ "$_fit" = yes ] && [ -n "$_best" ]; then
        if [ "$_bw" -lt $(( _dw - 4 )) ] || [ "$_bw" -gt $(( _dw + 4 )) ] \
          || [ "$_bh" -lt $(( _dh - 4 )) ] || [ "$_bh" -gt $(( _dh + 4 )) ] \
          || [ "$_bx" != 0 ] || [ "$_by" != 0 ]; then
          DISPLAY="$_dpy" "$_robot" windowsize "$_best" 100% 100% \
            windowmove "$_best" 0 0 2>/dev/null
        fi
      fi
      _old="$_new"
      _age=$(( _age + 1 ))
      # without -r the display cannot change, so this helper is only needed
      # while a browser starts; do not leave it polling for the whole session
      if [ "$_follow" != yes ]; then
        if [ "$_settle" -le 0 ] || [ "$_age" -ge 60 ]; then
          exit 0
        fi
      fi
      sleep 1
    done
  }
  if [ -n "$wm" ]; then
    DISPLAY="$display" $wm >/dev/null 2>&1 &
  fi
  if [ -n "$xtool" ]; then
    _follow_resize "$xtool" "$display" "$settle" "$follow" &
  fi
  if [ -x /usr/X11R6/bin/xsetroot ]; then
    /usr/X11R6/bin/xsetroot -display "$display" -cursor_name left_ptr 2>/dev/null
  fi
  exec "$@"
' _ "$_SANDBOX_HOME" "$_DISPLAY" "$_WM" "$_XDOOL" "$_FIT" "$_FOLLOW" \
  "$_SANDBOX_XAUTH" /usr/bin/env -i \
  DISPLAY="$_DISPLAY" \
  HOME="$_SANDBOX_HOME" \
  LOGNAME="$FSUNABA_USER" \
  USER="$FSUNABA_USER" \
  XAUTHORITY="$_SANDBOX_XAUTH" \
  PATH="/usr/bin:/bin:/usr/X11R6/bin:/usr/local/bin" \
  "$@"
_status=$?

_cleanup
exit "$_status"
